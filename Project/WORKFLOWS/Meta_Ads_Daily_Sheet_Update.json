    {
      "parameters": {
        "jsCode": "const numDays = 07;\nconst endDate = new Date();\nconst startDate = new Date();\nstartDate.setDate(endDate.getDate() - numDays);\nconst dates = [];\n\nlet currentDate = new Date(startDate);\nwhile (currentDate <= endDate) {\n  const yyyy = currentDate.getFullYear();\n  const mm = String(currentDate.getMonth() + 1).padStart(2, '0');\n  const dd = String(currentDate.getDate()).padStart(2, '0');\n  dates.push({ json: { date: `${yyyy}-${mm}-${dd}` } });\n  currentDate.setDate(currentDate.getDate() + 1);\n}\n\nreturn dates;"
      },
      "id": "c27616d6-ca8c-4c13-a9d4-a65d441ea659",
      "name": "Tạo mảng ngày",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -656,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "let items = $input.all();\nconst isManual = $execution.mode === 'manual';\nif (isManual && items.length > 2) {\n  items = items.slice(0, 2);\n}\nconst staticData = $getWorkflowStaticData('global');\nconst now = Date.now();\nif (staticData.lastMetaCall && (now - staticData.lastMetaCall < 60000)) {\n  throw new Error('Cooldown: Lần gọi Meta API trước < 60 giây. Đã dừng workflow.');\n}\nstaticData.lastMetaCall = now;\nconst results = [];\nfor (const item of items) {\n  const date = item.json.date;\n  const timeRange = encodeURIComponent(JSON.stringify({since: date, until: date}));\nconst url = `https://graph.facebook.com/v19.0/act_303484773737553/insights?time_range=${timeRange}&level=ad&fields=ad_id,ad_name,campaign_id,campaign_name,account_id,spend,reach,clicks,inline_link_clicks,actions,date_start,impressions,frequency,video_view,video_p25_watched_actions,video_p50_watched_actions,video_p75_watched_actions,video_p95_watched_actions,video_thruplay_watched_actions,outbound_clicks`;\n  let success = false;\n  let attempts = 0;\n  let responseData = {};\n  while (!success && attempts < 3) {\n    attempts++;\n    try {\n      const token = $env.META_ACCESS_TOKEN;\n      if (!token) {\n        throw new Error('Missing META_ACCESS_TOKEN environment variable.');\n      }\n      const response = await this.helpers.httpRequest({\n        method: 'GET',\n        url: url,\n        json: true,\n        headers: {\n          Authorization: `Bearer ${token}`\n        }\n      });\n      responseData = response;\n      success = true;\n    } catch (error) {\n      const metaErrorBody = error.response?.data\n        ? JSON.stringify(error.response.data)\n        : '';\n      const errMsg = (error.message || '') + ' ' + metaErrorBody;\n      const isRateLimitError = errMsg.includes('Application request limit reached');\n      const networkErrorPatterns = [\n        'Client network socket disconnected',\n        'ECONNRESET',\n        'ETIMEDOUT',\n        'socket hang up'\n      ];\n      const isNetworkError = networkErrorPatterns.some(p =>\n        errMsg.toLowerCase().includes(p.toLowerCase())\n      );\n      if (isRateLimitError) {\n        if (attempts >= 3) {\n          throw new Error('Rate limit. Vẫn lỗi sau 3 lần retry. Meta error: ' + metaErrorBody);\n        }\n        const waitTime = Math.floor(Math.random() * (120000 - 60000 + 1)) + 60000;\n        await new Promise(resolve => setTimeout(resolve, waitTime));\n      } else if (isNetworkError) {\n        if (attempts >= 3) {\n          throw new Error('Lỗi mạng tạm thời. Vẫn lỗi sau 3 lần retry.');\n        }\n        await new Promise(resolve => setTimeout(resolve, attempts * 3000));\n      } else {\n        throw new Error(\n          'Meta API Error: ' + JSON.stringify(error.response?.data || error.message, null, 2)\n        );\n      }\n    }\n  }\n  results.push({ json: responseData });\n  await new Promise(resolve => setTimeout(resolve, 2000));\n}\nreturn results;"
      },
      "id": "1537644d-fc50-4273-a8e5-85a772519976",
      "name": "Lấy dữ liệu Meta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -432,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const sheetData = $('Đọc toàn bộ Sheet').first().json.values || [];\nif (sheetData.length === 0) {\n  throw new Error(\"Sheet is completely empty! Please run Temp: Update Headers first.\");\n}\n\nconst headers = sheetData[0];\nconst headerMap = {};\nheaders.forEach((h, index) => {\n    headerMap[String(h).trim()] = index;\n});\n\nconst requiredHeaders = [\n  \"Ma_quang_cao\", \"Ngay\", \"Chien_dich\", \"Ten_quang_cao\", \"Chi_tieu\",\n  \"Nguoi_tiep_can\", \"Ngan_sach\", \"click\", \"Mess_Comment\",\n  \"Khach_sai_tep\", \"Khach_hop_le\", \"SDT\", \"Khach_chot\",\n  \"Chi_phi_tren_khach_hop_le\", \"Chi_phi_khach_tren_SDT\", \"Doanh_thu\",\n  \"ghi_chu\", \"Trang_Thai\", \"Key\", \"Thoi_diem_cap_nhat\",\n\n  \"Luot_hien_thi\",\n  \"Tan_suat\",\n  \"Xem_3s\",\n  \"Video_25\",\n  \"Video_50\",\n  \"Video_75\",\n  \"Video_95\",\n  \"ThruPlay\",\n  \"Click_Ra_Web\",\n  \"Click_All\"\n];\n\nfor(const h of requiredHeaders) {\n  if (headerMap[h] === undefined) {\n    throw new Error(`THIẾU CỘT BẮT BUỘC: [${h}]. Vui lòng bổ sung vào dòng 1 của Sheet và không được đổi tên.`);\n  }\n}\n\nconst existingMap = {};\nfor(let r=1; r < sheetData.length; r++) {\n  const rowArray = sheetData[r];\n  const key = rowArray[headerMap[\"Key\"]];\n  if(key) {\n    existingMap[key] = {\n      khachSaiTep: parseInt(rowArray[headerMap[\"Khach_sai_tep\"]] || '0', 10),\n      sdt: parseInt(rowArray[headerMap[\"SDT\"]] || '0', 10),\n      khachChot: parseInt(rowArray[headerMap[\"Khach_chot\"]] || '0', 10)\n    };\n  }\n}\n\nconst adsRaw = $('Lấy cấu hình Meta').first().json.data || [];\nconst adsMap = {};\nadsRaw.forEach(ad => { adsMap[ad.id] = ad; });\n\n// ===== KPI Helpers =====\n\nfunction getActionValue(actionsArray, actionType) {\n  if (!Array.isArray(actionsArray)) return 0;\n  const found = actionsArray.find(a => a.action_type === actionType);\n  return found ? (parseInt(found.value, 10) || 0) : 0;\n}\n\nfunction getVideoFieldValue(videoArray) {\n  if (!Array.isArray(videoArray) || videoArray.length === 0) return 0;\n  return parseInt(videoArray[0].value, 10) || 0;\n}\n\nfunction getOutboundClicks(outboundData) {\n  if (!Array.isArray(outboundData)) return 0;\n  const found = outboundData.find(x => x && x.value !== undefined);\n  return found ? (parseInt(found.value,10) || 0) : 0;\n}\n\nconst allItems = [];\n\n$input.all().forEach(insightItem => {\n  const insights = insightItem.json.data || [];\n  \n  insights.forEach(row => {\n    const adDetail = adsMap[row.ad_id] || {};\n    const adset = adDetail.adset || {};\n    const status = adDetail.effective_status === 'ACTIVE' ? 'Bật' : 'Tắt';\n    \n    let rawBudget = adset.daily_budget || adset.lifetime_budget || \"0\";\n    let budget = parseInt(String(rawBudget).replace(/\\./g, '').replace(/,/g, ''), 10);\n    if (isNaN(budget)) budget = 0;\n\n    let totalMess = 0;\n    if (row.actions) {\n      const messAction = row.actions.find(a => a.action_type === 'onsite_conversion.messaging_conversation_started_7d');\n      totalMess = messAction ? parseInt(messAction.value, 10) : 0;\n    }\n    \n    // Google Sheet:\n    // - click      -> Link Click (inline_link_clicks)\n    // - Click_All  -> Total Clicks (clicks)\n    const clickLink = parseInt(row.inline_link_clicks, 10) || 0;\n    const clickAll = parseInt(row.clicks, 10) || 0;\n\n    const spend = parseFloat(row.spend) || 0;\n    const reach = parseInt(row.reach, 10) || 0;\n    const impressions = parseInt(row.impressions, 10) || 0;\n    const frequency = parseFloat(row.frequency) || 0;\n\n    const xem3s = getActionValue(row.actions, \"video_view\");\n    const video25 = getVideoFieldValue(row.video_p25_watched_actions);\n    const video50 = getVideoFieldValue(row.video_p50_watched_actions);\n    const video75 = getVideoFieldValue(row.video_p75_watched_actions);\n    const video95 = getVideoFieldValue(row.video_p95_watched_actions);\n    const thruplay = getVideoFieldValue(row.video_thruplay_watched_actions);\n    const clickRaWeb = getOutboundClicks(row.outbound_clicks);\n\n    const key = `${row.date_start}_${row.ad_id}`;\n    \n    const manual = existingMap[key] || { khachSaiTep: 0, sdt: 0, khachChot: 0 };\n    \n    let validLeads = totalMess - manual.khachSaiTep;\n    if(validLeads < 0) validLeads = 0;\n\n    const vnTime = new Date(new Date().toLocaleString(\"en-US\", {timeZone: \"Asia/Ho_Chi_Minh\"}));\n    const dd = String(vnTime.getDate()).padStart(2, '0');\n    const mm = String(vnTime.getMonth() + 1).padStart(2, '0');\n    const yyyy = vnTime.getFullYear();\n    const HH = String(vnTime.getHours()).padStart(2, '0');\n    const min = String(vnTime.getMinutes()).padStart(2, '0');\n    const ss = String(vnTime.getSeconds()).padStart(2, '0');\n    const timestamp = `${dd}/${mm}/${yyyy} ${HH}:${min}:${ss}`;\n\n    if (existingMap[key]) {\n      allItems.push({\n        json: {\n          __actionType: \"update\",\n          \"Key\": key,\n          \"Chi_tieu\": spend,\n          \"Nguoi_tiep_can\": reach,\n          \"click\": clickLink,\n          \"Mess_Comment\": totalMess,\n          \"Thoi_diem_cap_nhat\": timestamp,\n          \"Luot_hien_thi\": impressions,\n          \"Tan_suat\": frequency,\n          \"Xem_3s\": xem3s,\n          \"Video_25\": video25,\n          \"Video_50\": video50,\n          \"Video_75\": video75,\n          \"Video_95\": video95,\n          \"ThruPlay\": thruplay,\n          \"Click_Ra_Web\": clickRaWeb,\n          \"Click_All\": clickAll\n        }\n      });\n    } else {\n      allItems.push({\n        json: {\n          __actionType: \"append\",\n          \"Ma_quang_cao\": row.ad_id,\n          \"Ngay\": row.date_start,\n          \"Chien_dich\": row.campaign_name,\n          \"Ten_quang_cao\": row.ad_name,\n          \"Chi_tieu\": spend,\n          \"Nguoi_tiep_can\": reach,\n          \"Ngan_sach\": budget,\n          \"click\": clickLink,\n          \"Mess_Comment\": totalMess,\n          \"Trang_Thai\": status,\n          \"Key\": key,\n          \"Thoi_diem_cap_nhat\": timestamp,\n          \"Luot_hien_thi\": impressions,\n          \"Tan_suat\": frequency,\n          \"Xem_3s\": xem3s,\n          \"Video_25\": video25,\n          \"Video_50\": video50,\n          \"Video_75\": video75,\n          \"Video_95\": video95,\n          \"ThruPlay\": thruplay,\n          \"Click_Ra_Web\": clickRaWeb,\n          \"Click_All\": clickAll\n        }\n      });\n    }\n  });\n});\n\nif (allItems.length === 0) return [{ json: { __actionType: 'skip', msg: 'No data' } }];\n\nreturn allItems;"
      },
