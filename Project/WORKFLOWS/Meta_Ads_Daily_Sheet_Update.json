        "jsCode": "function safeCount(nodeName) {\n  try {\n    return $(nodeName).all().length;\n  } catch (error) {\n    if (String(error?.message || error).includes(\"hasn't been executed\")) {\n      return 0;\n    }\n    throw error;\n  }\n}\n\nconst appends = safeCount('IF: Append?');\nconst updates = safeCount('IF: Update?');\n\nreturn [{\n  json: {\n    message: \"Success\",\n    appendCount: appends,\n    updateCount: updates\n  }\n}];"
      },
