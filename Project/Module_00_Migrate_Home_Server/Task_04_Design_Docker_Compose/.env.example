# ============================================================
# n8n environment template — copy thành .env và điền giá trị
# cp .env.example .env
# KHÔNG commit file .env (có secret)
# ============================================================

# --- Critical: credential continuity (lấy từ Task 01 Windows audit) ---
# Không generate key mới nếu restore credentials cũ
N8N_ENCRYPTION_KEY=

# --- Basic Auth (bảo vệ UI local) ---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# --- Host / URL (local recovery trước; Task 05 đổi sang domain public) ---
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# --- Timezone (trùng compose; giữ để ghi rõ intent) ---
TZ=Asia/Ho_Chi_Minh
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh

# --- Telegram (ENVIRONMENT_REGISTRY) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Meta (ENVIRONMENT_REGISTRY / CREDENTIAL_INVENTORY) ---
# Long-lived user/system token dùng trong workflow
META_ACCESS_TOKEN=
# Tuỳ chọn — nếu workflow/app auth cần
META_APP_ID=
META_APP_SECRET=

# --- Google Sheets identifiers (không phải OAuth secret; OAuth qua n8n credential UI) ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=

# --- Cloudflare (Task 05+; để trống khi local-only) ---
# CLOUDFLARE_TUNNEL_TOKEN=
